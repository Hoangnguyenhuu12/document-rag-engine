# Environment Variables for Document RAG Engine

# --- Google Gemini Configuration ---
# Lấy API key tại: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# --- OpenAI Configuration ---
# Lấy API key tại: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# --- Ollama Local Configuration (Optional) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Vector Store Persistence Directory ---
CHROMA_PERSIST_DIR=data/chroma_db

# --- Web API Server Configuration ---
API_HOST=0.0.0.0
API_PORT=8000
